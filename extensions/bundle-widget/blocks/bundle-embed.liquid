{% assign appify_collection_ids = product.collections | map: 'id' | join: ',' %}
{% if template.name == 'product' and product %}
  <div
    class="appify-bundle-widget"
    data-appify-bundle-widget
    data-placement="product"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-image="{{ product.featured_image | image_url: width: 160 }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-variant-price-cents="{{ product.selected_or_first_available_variant.price }}"
    data-variant-compare-cents="{{ product.selected_or_first_available_variant.compare_at_price }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-collection-ids="{{ appify_collection_ids }}"
    data-proxy-url="/apps/appify-bundles/bundles"
    data-analytics-url="/apps/appify-bundles/analytics"
  ></div>
{% elsif template.name == 'cart' %}
  <div
    class="appify-bundle-widget"
    data-appify-bundle-widget
    data-placement="cart"
    data-currency="{{ cart.currency.iso_code }}"
    data-proxy-url="/apps/appify-bundles/bundles"
    data-analytics-url="/apps/appify-bundles/analytics"
  ></div>
{% endif %}

{% schema %}
{
  "name": "Appify Bundles",
  "target": "body",
  "javascript": "bundle-widget.js",
  "stylesheet": "bundle-widget.css",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows bundle offers, quantity breaks, add-ons, and gift unlocks. Customize in the Appify Bundles app."
    }
  ]
}
{% endschema %}
