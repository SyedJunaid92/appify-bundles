# Shopify App credentials (from Partner Dashboard)
SHOPIFY_API_KEY=72ca0353b39ec68fb4dbd3c1f90982cd
SHOPIFY_API_SECRET=shpss_your_secret_from_partner_dashboard
SCOPES=read_products,write_products,write_cart_transforms,read_orders,read_discounts,write_discounts,read_themes

# Your deployed app URL (Vercel production URL, no trailing slash)
SHOPIFY_APP_URL=https://your-app.vercel.app

# PostgreSQL — URL-encode special characters in the password
# Example: bknseQ2@/&RhjU! becomes bknseQ2%40%2F%26RhjU%21
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

NODE_ENV=production

# Billing mode (optional override):
#   unset = auto-detect (dev/partner stores → test, real stores → live)
#   true  = force test charges for all shops
#   false = force live charges for all shops
# SHOPIFY_BILLING_TEST=true

# Secret for Vercel cron auth (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_random_secret_here

# Upstash Redis (REST) — dashboard/stats cache. App works without it.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
